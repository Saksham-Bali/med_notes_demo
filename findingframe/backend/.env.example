# FindingFrame backend config — copy to .env and fill in. NEVER commit .env.
FF_ENV=dev
FF_LOG_LEVEL=INFO
FF_CORS_ORIGINS=["http://localhost:3000"]

# --- Database (Supabase Postgres, async DSN; URL-encode special chars in the password) ---
# Direct (IPv6): db.<ref>.supabase.co:5432   |   IPv4 session pooler: aws-0-<region>.pooler.supabase.com:5432 (user postgres.<ref>)
FF_DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres

# --- Supabase ---
FF_SUPABASE_URL=https://<ref>.supabase.co
FF_SUPABASE_PROJECT_REF=<ref>
FF_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Backend verifies user JWTs via the public JWKS (ES256) — no secret required.
FF_SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
FF_JWT_AUDIENCE=authenticated
# Optional: only if the project uses legacy HS256 tokens
FF_SUPABASE_JWT_SECRET=

# --- PII encryption (pgcrypto symmetric key for ff.patient_identifiers) ---
FF_PII_ENCRYPTION_KEY=change-me

# --- Engine (FindingFrame at ../../tmc) ---
FF_ENGINE_PATH=../../tmc
FF_LLM_PROVIDER=openrouter
FF_LLM_MODEL=openai/gpt-5.5
FF_LLM_REASONING_EFFORT=medium
FF_OPENROUTER_API_KEY=
FF_OPENAI_API_KEY=

# --- Worker ---
FF_WORKER_ID=worker-1
FF_LLM_RATE_LIMIT_PER_MIN=5
