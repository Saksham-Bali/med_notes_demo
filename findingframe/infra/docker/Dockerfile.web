# FindingFrame web — Next.js 14 App Router (TS, Tailwind, TanStack Query, @supabase/supabase-js).
# next.config.mjs does not set `output: "standalone"`, so the runtime stage ships
# node_modules + .next + package.json rather than a standalone bundle.
#
# Build context MUST be the findingframe/ repo root (see infra/docker-compose.yml).
# NEXT_PUBLIC_* vars are baked in at build time by Next.js — pass them as build args
# (docker-compose reads them from web/.env.local) if you rebuild against a different
# backend/Supabase project.
FROM node:20-slim AS deps
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci

FROM node:20-slim AS build
WORKDIR /app
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_API_MODE
ENV NEXT_PUBLIC_SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL} \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY} \
    NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_API_MODE=${NEXT_PUBLIC_API_MODE}
COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./
RUN npm run build

FROM node:20-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/next.config.mjs ./next.config.mjs

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=5 \
  CMD curl -fsS http://localhost:3000/ || exit 1

CMD ["npm", "run", "start", "--", "-p", "3000"]
