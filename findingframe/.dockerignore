# Keep Docker build contexts (infra/docker-compose.yml uses the repo root as context)
# small and correct — without this, `COPY web/ ./` would drag in a local
# node_modules/.next and clobber what Dockerfile.web just installed/built.
**/.git
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
backend/.venv
backend/tests
web/node_modules
web/.next
web/out
web/*.tsbuildinfo
web/next-env.d.ts
**/.DS_Store
